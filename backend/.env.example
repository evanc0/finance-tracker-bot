TELEGRAM_BOT_TOKEN=your_bot_token_here
WEB_APP_URL=https://your-web-app-url.com

# --- Хранение данных в Google Таблице ---
# ID таблицы из её URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here
# Либо полный URL таблицы (альтернатива SPREADSHEET_ID):
# SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id/edit

# JSON-ключ сервисного аккаунта: содержимое файла одной строкой (или в base64).
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com", ...}
# Либо путь к файлу ключа (удобно локально):
# GOOGLE_APPLICATION_CREDENTIALS=./service_account.json
